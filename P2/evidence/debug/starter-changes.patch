+
+// A basic merge sort routine that sorts the subarray A[p..r]
+static void sort_recursive_f(data_t* A, int p, int r, data_t* left) {
+  assert(A);
+  if (p >= r) return;
+  if (r - p + 1 <= COARSE_THRESHOLD) {
+    isort(A + p, A + r);
+    return;
+  }
+  if (p < r) {
+    int q = (p + r) / 2;
+    sort_recursive_f(A, p, q, left);
+    sort_recursive_f(A, q + 1, r, left);
+    merge_f(A, p, q, r, left);
+  }
+}
+
+// A merge routine. Merges the sub-arrays A [p..q] and A [q + 1..r].
+// Copy only the left half; read the right half directly from A.
+static void merge_f(data_t* A, int p, int q, int r, data_t* left) {
+  assert(A);
+  assert(p <= q);
+  assert((q + 1) <= r);
+  int n1 = q - p + 1;
+  copy_f(A + p, left, n1);
+
+  int i = 0, j = q + 1, k = p;
+  // While left remains, k < j: writing A[k] cannot overwrite unread A[j].
+  while (i < n1 && j <= r) {
+    if (left[i] <= A[j]) A[k++] = left[i++];
+    else A[k++] = A[j++];
+  }
+  while (i < n1) A[k++] = left[i++];
+  // Any remaining right-side elements are already in their final positions.
+}
+
+static void copy_f(data_t* source, data_t* dest, int n) {
+  assert(dest);
+  assert(source);
+
+  for (int i = 0 ; i < n ; i++) {
+    dest[i] = source[i];
+  }
+}
 
