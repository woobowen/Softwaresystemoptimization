+    mem_free(&left);
+    mem_free(&right);
+    return;
+  }
+
+  copy_p(&(A[p]), left, n1);
+  copy_p(&(A[q + 1]), right, n2);
+  left[n1] = UINT_MAX;
+  right[n2] = UINT_MAX;
+
+  data_t* l = left;
+  data_t* right_pos = right;
+  data_t* out = A + p;
+  data_t* end = A + r + 1;
+  while (out < end) {
+    if (*l <= *right_pos) *out++ = *l++;
+    else *out++ = *right_pos++;
+  }
+  mem_free(&left);
+  mem_free(&right);
+}
+
+static inline void copy_p(data_t* source, data_t* dest, int n) {
+  assert(dest);
+  assert(source);
+
+  data_t* end = source + n;
+  while (source < end) *dest++ = *source++;
+}
