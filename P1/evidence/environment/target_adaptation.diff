# Diff normalizes CRLF and trailing whitespace; the byte-exact input is preserved separately.
--- matrix_multiplication.original.c
+++ matrix_multiplication.c
@@ -1,6 +1,7 @@
+#define _POSIX_C_SOURCE 200809L
 #include <stdlib.h>
 #include <stdio.h>
-#include <sys/time.h>
+#include <time.h>
 #include <assert.h>
 
 #define n 4096
@@ -9,19 +10,25 @@
 double B[n][n];
 double C[n][n];
 
-float tdiff(struct timeval *start,
-            struct timeval *end) {
+float tdiff(struct timespec *start,
+            struct timespec *end) {
     return(end->tv_sec-start->tv_sec) +
-        1e-6*(end->tv_usec-start->tv_usec);
+        1e-9*(end->tv_nsec-start->tv_nsec);
 }
 
 int main(int argc, const char *argv[]){
-    assert(argc==2);
-    int s = atoi(argv[1]);
-    if (s < 1 || s > n) {
+    if (argc != 2) {
+        fprintf(stderr, "Usage: %s block_size\n", argv[0]);
+        return 1;
+    }
+    char *tail;
+    long block = strtol(argv[1], &tail, 10);
+    if (tail == argv[1] || *tail != '\0' || block < 1 || block > n) {
         printf("Invalid input values.\n");
         return -1;
     }
+
+    int s = (int)block;
 
     for(int i = 0; i < n; ++i){
         for(int j = 0; j < n; ++j) {
@@ -31,8 +38,8 @@
         }
     }
 
-    struct timeval start, end;
-    gettimeofday(&start, NULL);
+    struct timespec start, end;
+    if (clock_gettime(CLOCK_MONOTONIC, &start) != 0) return 1;
 
     for(int ih = 0; ih < n; ih += s)
         for(int jh = 0; jh < n; jh += s)
@@ -42,7 +49,13 @@
                         for(int jl = 0; jl < s && jh + jl < n; ++jl)
                             C[ih+il][jh+jl] += A[ih+il][kh+kl] * B[kh+kl][jh+jl];
 
-    gettimeofday(&end, NULL);
+    if (clock_gettime(CLOCK_MONOTONIC, &end) != 0) return 1;
     printf("%0.6f\n",tdiff(&start, &end));
+    /* Consume the result after timing so every build computes C. */
+    double checksum = 0.0;
+    for (int i = 0; i < n; ++i)
+        for (int j = 0; j < n; ++j)
+            checksum += C[i][j];
+    printf("checksum=%.17g\n", checksum);
     return 0;
 }
